{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cineflow-ai-studio.local/schemas/flow_pipeline.schema.json",
  "title": "Google Flow Declarative Scene Pipeline Configuration (flow.json)",
  "description": "Declarative multi-scene Google Flow pipeline schema with global defaults, chained start/end keyframes, and canonical @PascalCase asset handles.",
  "type": "object",
  "required": ["scenes"],
  "properties": {
    "project": {
      "type": "string",
      "description": "Project title or Labs Flow URL."
    },
    "defaults": {
      "type": "object",
      "description": "Global defaults inherited by all scenes unless overridden per scene.",
      "properties": {
        "surface": {
          "type": "string",
          "enum": ["flow", "gemini-api"],
          "default": "flow"
        },
        "mediaType": {
          "type": "string",
          "enum": ["Video", "Image"],
          "default": "Video"
        },
        "mode": {
          "type": "string",
          "enum": ["Frames", "Ingredients", "text-to-video", "first-frame", "first-last-frame", "references-to-video", "extend", "video-edit"],
          "default": "Frames"
        },
        "aspect": {
          "type": "string",
          "enum": ["16:9", "9:16"],
          "default": "16:9"
        },
        "resolution": {
          "type": "string",
          "enum": ["360p", "720p", "1080p", "4K"],
          "default": "720p"
        },
        "duration": {
          "type": "string",
          "enum": ["3s", "4s", "5s", "6s", "7s", "8s", "9s", "10s", "11s", "12s", "13s", "14s", "15s"],
          "default": "8s"
        },
        "outputs": {
          "type": "integer",
          "enum": [1, 2, 3, 4],
          "default": 1
        },
        "model": {
          "type": "string",
          "enum": [
            "Omni 1.2 Flash",
            "Gemini Omni 1.2 Flash",
            "Omni 1.1 Flash",
            "Veo 3.1 - Lite",
            "Veo 3.1 - Fast",
            "Veo 3.1 - Fast [Lower Priority]",
            "Veo 3.1 - Quality",
            "Nano Banana Pro",
            "Nano Banana 2",
            "Imagen 4"
          ],
          "default": "Omni 1.2 Flash"
        }
      },
      "additionalProperties": false
    },
    "declared_handles": {
      "type": "array",
      "description": "Canonical @PascalCase reference handles registered in the asset sheet.",
      "items": {
        "type": "string",
        "pattern": "^@[A-Za-z][A-Za-z0-9]*$"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "prompt"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique scene identifier (e.g., scene_01)."
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "description": "Self-contained generation prompt (physical action first, zero backward references, zero token-bleed numbers/hex codes)."
          },
          "handoff": {
            "type": "string",
            "enum": ["FIRST", "CUT", "CONTINUATION"],
            "default": "CUT",
            "description": "Scene transition contract from the preceding segment."
          },
          "mediaType": {
            "type": "string",
            "enum": ["Video", "Image"]
          },
          "mode": {
            "type": "string",
            "enum": ["Frames", "Ingredients", "text-to-video", "first-frame", "first-last-frame", "references-to-video", "extend", "video-edit"]
          },
          "aspect": {
            "type": "string",
            "enum": ["16:9", "9:16"]
          },
          "resolution": {
            "type": "string",
            "enum": ["360p", "720p", "1080p", "4K"]
          },
          "duration": {
            "type": "string",
            "enum": ["3s", "4s", "5s", "6s", "7s", "8s", "9s", "10s", "11s", "12s", "13s", "14s", "15s"]
          },
          "outputs": {
            "type": "integer",
            "enum": [1, 2, 3, 4]
          },
          "model": {
            "type": "string",
            "enum": [
              "Omni 1.2 Flash",
              "Gemini Omni 1.2 Flash",
              "Omni 1.1 Flash",
              "Veo 3.1 - Lite",
              "Veo 3.1 - Fast",
              "Veo 3.1 - Fast [Lower Priority]",
              "Veo 3.1 - Quality",
              "Nano Banana Pro",
              "Nano Banana 2",
              "Imagen 4"
            ]
          },
          "start": {
            "type": "string",
            "description": "Path to start keyframe image (can chain from previous scene end keyframe)."
          },
          "end": {
            "type": "string",
            "description": "Path to end keyframe image."
          },
          "ingredients": {
            "type": "array",
            "items": { "type": "string" },
            "maxItems": 7,
            "description": "Up to 7 ingredient asset paths on Omni 1.2 Flash (front/back product/garment photos, 3s motion clips, 1s voice references; up to 3 on Veo 3.1)."
          },
          "output": {
            "type": "string",
            "description": "Target output filename (e.g., output/01_establishment.mp4)."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
