{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CineFlow AI Studio Unified Production, Showrunner Package & OpenMontage Governance Schema",
  "type": "object",
  "required": [
    "project",
    "identity_bible",
    "blocks",
    "overlays",
    "outro",
    "production_profile",
    "script_and_content",
    "global_parameters",
    "scene_breakdown",
    "post_production_timeline",
    "production_governance",
    "outro_standardization",
    "marketing_expansion",
    "qa_audit"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title", "purpose", "format", "style", "aspect_ratio", "total_runtime_s", "verified_capabilities"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "purpose": {
          "type": "string",
          "enum": [
            "Commercials & TVCs",
            "Corporate Videos",
            "Educational & Training",
            "Explainer Videos",
            "Testimonial Videos",
            "Documentaries",
            "Event Videos",
            "Entertainment Videos"
          ]
        },
        "format": { "type": "string" },
        "style": { "type": "string" },
        "platform": { "type": "string" },
        "aspect_ratio": {
          "type": "string",
          "enum": ["9:16", "16:9", "1:1", "4:5", "21:9"]
        },
        "total_runtime_s": { "type": "integer", "minimum": 4, "maximum": 600 },
        "language_dialect": { "type": "string" },
        "verified_capabilities": {
          "type": "object",
          "required": ["per_clip_s_options", "extend_cap_s"],
          "properties": {
            "per_clip_s_options": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "integer", "enum": [4, 6, 8, 10] }
            },
            "extend_cap_s": { "type": "integer", "minimum": 4, "maximum": 40 },
            "audio": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "motion_engine_60fps": { "type": "object" }
      }
    },
    "identity_bible": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "descriptor"],
        "properties": {
          "id": { "type": "string", "pattern": "^(CHAR|ENV|PROD|PROP)_[0-9]{2}$" },
          "descriptor": { "type": "string", "minLength": 5 },
          "reference_prompt": { "type": "string" },
          "reference_images": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "style_bible": { "type": "object" },
    "audio_map": { "type": "object" },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["block_id", "mode", "duration_s", "ids_used", "shots"],
        "properties": {
          "block_id": { "type": "integer", "minimum": 1 },
          "mode": {
            "type": "string",
            "enum": ["Ingredients", "Frames", "Extend", "Text-to-Video"]
          },
          "duration_s": {
            "type": "integer",
            "enum": [4, 6, 8, 10]
          },
          "extend_from_block": {
            "type": ["integer", "null"]
          },
          "ids_used": {
            "type": "array",
            "items": { "type": "string" }
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["shot_id", "t_range", "visual_prompt_en", "camera", "lighting_grade", "emotion_body_language", "negatives"],
              "properties": {
                "shot_id": { "type": "string", "minLength": 1 },
                "t_range": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?-[0-9]+(\\.[0-9]+)?$" },
                "visual_prompt_en": { "type": "string", "minLength": 10 },
                "camera": { "type": "string" },
                "lighting_grade": { "type": "string" },
                "emotion_body_language": { "type": "string" },
                "dialogue_ar": { "type": "string" },
                "dialogue_tts_ar": { "type": "string" },
                "dialogue_gloss_en": { "type": "string" },
                "audio_sync": { "type": "string" },
                "negatives": { "type": "string" }
              }
            }
          },
          "continuity_note": { "type": "string" }
        }
      }
    },
    "overlays": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["start_s", "end_s", "text_ar"],
        "properties": {
          "start_s": { "type": "number", "minimum": 0 },
          "end_s": { "type": "number", "minimum": 0 },
          "text_ar": { "type": "string", "minLength": 1 },
          "position": { "type": "string" },
          "style": { "type": "string" }
        }
      }
    },
    "outro": {
      "type": "object",
      "required": ["safe_zone", "cta_ar"],
      "properties": {
        "safe_zone": { "type": "string", "minLength": 1 },
        "cta_ar": { "type": "string", "minLength": 1 },
        "handles": { "type": "string" }
      }
    },
    "audit_report": { "type": "object" },
    "generation_order": {
      "type": "array",
      "items": { "type": "integer" }
    },
    "credit_estimate": { "type": "object" },
    "production_profile": {
      "type": "object",
      "required": ["purpose", "format", "style_variant", "pipeline_type", "target_platform", "aspect_ratio"],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "Commercials & TVCs",
            "Corporate Videos",
            "Educational & Training",
            "Explainer Videos",
            "Testimonial Videos",
            "Documentaries",
            "Event Videos",
            "Entertainment Videos"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "Live-Action",
            "Animation (2D / 3D)",
            "Motion Graphics",
            "Live Streaming",
            "360 & Interactive"
          ]
        },
        "style_variant": {
          "type": "string",
          "enum": [
            "Montage Sequence",
            "Music Videos",
            "Commercial Promo",
            "Short-Form Edits / AMV",
            "Sizzle Reel / Recap",
            "Narrative Continuity Sequence"
          ]
        },
        "pipeline_type": {
          "type": "string",
          "enum": [
            "route_1_generative_cinema",
            "route_2_talking_head_reel",
            "route_3_motion_stage_60fps",
            "route_4_silent_broll_montage",
            "route_5_multicam_podcast",
            "route_6_3d_device_explainer",
            "route_7_documentary_montage",
            "route_8_character_animation_ink_theater",
            "route_9_3d_world_generation",
            "route_10_reference_video_cloner",
            "route_11_avatar_spokesperson",
            "route_12_localization_dub"
          ]
        },
        "execution_route": { "type": "string" },
        "target_platform": { "type": "string" },
        "aspect_ratio": {
          "type": "string",
          "enum": ["9:16", "16:9", "1:1", "4:5", "21:9"]
        },
        "runtime_category": { "type": "string" }
      }
    },
    "script_and_content": {
      "type": "object",
      "required": ["video_title", "narrative_framework", "full_spoken_script"],
      "properties": {
        "video_title": { "type": "string" },
        "narrative_framework": { "type": "string" },
        "audience_emotional_truth": { "type": "string" },
        "expected_cliche_rejected": { "type": "string" },
        "chosen_divergence_angle": { "type": "string" },
        "research_brief_summary": { "type": "object" },
        "hook_variants_scene_1": { "type": "object" },
        "full_spoken_script": { "type": "string" },
        "facts_ledger": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "global_parameters": {
      "type": "object",
      "required": [
        "tone",
        "body_language_baseline",
        "dialect_lock",
        "color_grading",
        "camera_gear_emulation",
        "identity_lock_target",
        "total_runtime_seconds"
      ],
      "properties": {
        "tone": { "type": "string" },
        "body_language_baseline": { "type": "string" },
        "dialect_lock": { "type": "string" },
        "color_grading": { "type": "string" },
        "camera_gear_emulation": { "type": "string" },
        "identity_lock_target": { "type": "string" },
        "credit_governance_mode": { "type": "string" },
        "total_runtime_seconds": { "type": "integer", "minimum": 4, "maximum": 600 }
      }
    },
    "scene_breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "duration_seconds",
          "shot_intent",
          "visual_prompt",
          "audio_foley_sync",
          "dialogue_lip_sync",
          "text_overlay"
        ],
        "properties": {
          "scene_id": { "type": "integer" },
          "scene_role": { "type": "string" },
          "duration_seconds": { "type": "integer", "enum": [4, 6, 8, 10] },
          "layout_mode": {
            "type": "string",
            "enum": ["R_FULL", "R_DOWN", "R_LOWER", "R_OFF"]
          },
          "type": { "type": "string" },
          "shot_intent": { "type": "string" },
          "information_role": { "type": "string" },
          "narrative_role": { "type": "string" },
          "hero_moment": { "type": "boolean" },
          "shot_language": { "type": "object" },
          "chai_5_aspect_breakdown": {
            "type": "object",
            "required": ["subject", "subject_motion", "scene", "spatial_framing", "camera"]
          },
          "texture_keywords": {
            "type": "array",
            "items": { "type": "string" }
          },
          "flow_mode": { "type": "string" },
          "continuity_handshake": { "type": "string" },
          "visual_prompt": { "type": "string" },
          "stage_motion_actors": { "type": "string" },
          "audio_foley_sync": { "type": "string" },
          "dialogue_lip_sync": { "type": "string" },
          "text_overlay": { "type": "string" }
        }
      }
    },
    "post_production_timeline": {
      "type": "object",
      "required": [
        "render_runtime",
        "composition_mode",
        "visual_design_style",
        "color_palette",
        "silence_cut_config",
        "depth_moments_planned",
        "rtl_caption_config",
        "audio_mastering_spec"
      ]
    },
    "production_governance": {
      "type": "object",
      "required": [
        "taste_profile",
        "delivery_promise",
        "slideshow_risk_report",
        "scene_variation_report",
        "scored_provider_selection",
        "decision_log",
        "budget_governance",
        "chai_final_review_checklist"
      ]
    },
    "outro_standardization": {
      "type": "object",
      "required": ["aspect_ratio", "brand_logo_safe_zone", "cta_and_handles_safe_zone"]
    },
    "marketing_expansion": { "type": "object" },
    "qa_audit": { "type": "object" }
  }
}
