{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CineFlow AI Studio Production & Programmatic Editing Blueprint Schema",
  "type": "object",
  "required": [
    "production_profile",
    "script_and_content",
    "global_parameters",
    "scene_breakdown",
    "post_production_timeline",
    "outro_standardization",
    "marketing_expansion",
    "qa_audit"
  ],
  "properties": {
    "production_profile": {
      "type": "object",
      "required": ["purpose", "format", "style_variant", "target_platform", "aspect_ratio"],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "Commercials & TVCs",
            "Corporate Videos",
            "Educational & Training",
            "Explainer Videos",
            "Testimonial Videos",
            "Documentaries",
            "Event Videos",
            "Entertainment Videos"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "Live-Action",
            "Animation (2D / 3D)",
            "Motion Graphics",
            "Live Streaming",
            "360 & Interactive"
          ]
        },
        "style_variant": {
          "type": "string",
          "enum": [
            "Montage Sequence",
            "Music Videos",
            "Commercial Promo",
            "Short-Form Edits / AMV",
            "Sizzle Reel / Recap",
            "Narrative Continuity Sequence"
          ]
        },
        "execution_route": {
          "type": "string"
        },
        "target_platform": {
          "type": "string",
          "default": "Google Flow (Veo 3.1 / Omni Flash 1.1 / Nano Banana Pro) + Remotion/FFmpeg Studio"
        },
        "aspect_ratio": {
          "type": "string",
          "enum": ["9:16", "16:9", "1:1", "4:5", "21:9"]
        },
        "runtime_category": {
          "type": "string"
        }
      }
    },
    "script_and_content": {
      "type": "object",
      "required": ["video_title", "narrative_framework", "full_spoken_script"],
      "properties": {
        "video_title": { "type": "string" },
        "narrative_framework": { "type": "string" },
        "audience_emotional_truth": { "type": "string" },
        "expected_cliche_rejected": { "type": "string" },
        "chosen_divergence_angle": { "type": "string" },
        "hook_variants_scene_1": {
          "type": "object",
          "properties": {
            "contrarian": { "type": "string" },
            "visual_payoff": { "type": "string" },
            "pain_point": { "type": "string" },
            "authority": { "type": "string" }
          }
        },
        "full_spoken_script": { "type": "string" },
        "facts_ledger": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "global_parameters": {
      "type": "object",
      "required": [
        "tone",
        "body_language_baseline",
        "dialect_lock",
        "color_grading",
        "camera_gear_emulation",
        "identity_lock_target",
        "total_runtime_seconds"
      ],
      "properties": {
        "tone": { "type": "string" },
        "body_language_baseline": { "type": "string" },
        "dialect_lock": { "type": "string" },
        "color_grading": { "type": "string" },
        "camera_gear_emulation": { "type": "string" },
        "identity_lock_target": { "type": "string" },
        "credit_governance_mode": { "type": "string" },
        "total_runtime_seconds": { "type": "integer", "minimum": 3 }
      }
    },
    "scene_breakdown": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene_id",
          "duration_seconds",
          "visual_prompt",
          "audio_foley_sync",
          "dialogue_lip_sync",
          "text_overlay"
        ],
        "properties": {
          "scene_id": { "type": "integer" },
          "scene_role": { "type": "string" },
          "duration_seconds": { "type": "integer", "minimum": 2, "maximum": 10 },
          "layout_mode": {
            "type": "string",
            "enum": ["R_FULL", "R_DOWN", "R_LOWER", "R_OFF"]
          },
          "flow_mode": { "type": "string" },
          "continuity_handshake": { "type": "string" },
          "visual_prompt": { "type": "string" },
          "stage_motion_actors": { "type": "string" },
          "audio_foley_sync": { "type": "string" },
          "dialogue_lip_sync": { "type": "string" },
          "text_overlay": { "type": "string" }
        }
      }
    },
    "post_production_timeline": {
      "type": "object",
      "required": [
        "visual_design_style",
        "color_palette",
        "silence_cut_config",
        "depth_moments_planned",
        "rtl_caption_config",
        "audio_mastering_spec"
      ],
      "properties": {
        "visual_design_style": { "type": "string" },
        "color_palette": { "type": "string" },
        "silence_cut_config": { "type": "object" },
        "depth_moments_planned": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rtl_caption_config": { "type": "object" },
        "audio_mastering_spec": { "type": "object" },
        "export_targets": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "outro_standardization": {
      "type": "object",
      "required": ["aspect_ratio", "brand_logo_safe_zone", "cta_and_handles_safe_zone"],
      "properties": {
        "aspect_ratio": { "type": "string" },
        "brand_logo_safe_zone": { "type": "string" },
        "cta_and_handles_safe_zone": { "type": "string" },
        "loop_back_visual_cue": { "type": "string" }
      }
    },
    "marketing_expansion": {
      "type": "object",
      "required": ["first_frame_cover", "poster_layout_prompt", "carousel_arabic_copy", "social_publish_pack"],
      "properties": {
        "first_frame_cover": { "type": "object" },
        "poster_layout_prompt": { "type": "string" },
        "social_design_brief": { "type": "string" },
        "carousel_arabic_copy": {
          "type": "array",
          "items": { "type": "string" }
        },
        "social_publish_pack": { "type": "object" }
      }
    },
    "qa_audit": {
      "type": "object",
      "properties": {
        "audio_math_passed": { "type": "boolean" },
        "micro_scene_limit_passed": { "type": "boolean" },
        "physicality_firewall_passed": { "type": "boolean" },
        "anti_cgi_guardrails_injected": { "type": "boolean" },
        "dialect_lock_verified": { "type": "boolean" },
        "outro_safe_zone_verified": { "type": "boolean" },
        "kashida_and_rtl_caption_verified": { "type": "boolean" },
        "calmness_and_hold_laws_verified": { "type": "boolean" },
        "audio_lufs_and_sfx_cap_verified": { "type": "boolean" }
      }
    }
  }
}
